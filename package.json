{
  "name": "life-design",
  "private": true,
  "version": "0.20.12",
  "description": "A private, phone-only daily journal built on Designing Your Life and Ikigai.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screens": "playwright test tests/e2e/screens.spec.ts",
    "ios-check": "python3 -I scripts/ios-check.py",
    "icons": "pwa-assets-generator",
    "privacy-scan": "sh scripts/privacy-scan.sh",
    "model": "node scripts/fetch-model.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "onnxruntime-web": "^1.30.0",
    "paddleocr": "1.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
